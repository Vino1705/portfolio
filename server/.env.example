# Copy to .env and fill in.

# Port the API/static server listens on (default 5174)
PORT=5174

# Access key for Web3Forms — the contact form relays through it.
# Get one free at https://web3forms.com. If this is empty the server accepts
# messages and logs them to the console instead of emailing.
WEB3FORMS_ACCESS_KEY=

# Comma-separated list of origins allowed to call the API.
# Leave empty to allow any origin (fine for a public portfolio).
ALLOWED_ORIGINS=
