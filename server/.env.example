# Copy to .env and fill in. Nothing here is required to run the site.

# Port the API/static server listens on (default 5174).
PORT=5174

# Comma-separated list of origins allowed to call the API.
# Leave empty to allow any origin (fine for a public portfolio).
ALLOWED_ORIGINS=

# Note: there is no mail key here. The contact form posts straight from the
# browser to Web3Forms, because Web3Forms rejects server-side submissions on
# the free plan. Its access key is public by design and lives in
# client/src/lib/contactForm.js.
